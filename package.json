{
  "name": "verity-helper",
  "version": "0.0.1",
  "author": "James Liang <lbz@rivensbane.com>",
  "license": "AGPL-3.0",
  "homepage": "https://verity.903684.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BozhanL/verity-helper.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-all:par": "concurrently --kill-others-on-fail npm:check npm:lint npm:format npm:test npm:test:e2e:all",
    "check-all": "npm run check-all:par -- -m 1",
    "check": "astro check --minimumFailingSeverity hint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --max-warnings 0 --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env BASE_PATH=/ playwright test",
    "test:e2e:subdirectory": "cross-env BASE_PATH=/review-preview playwright test",
    "test:e2e:all": "concurrently --kill-others-on-fail -m 1 npm:test:e2e npm:test:e2e:subdirectory",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "engines": {
    "node": "^26",
    "npm": "^11.20"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remeda": "2.51.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/cz-commitlint": "21.2.4",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "commitizen": "4.3.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-better-tailwindcss": "4.9.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-markdownlint": "1.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
