{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "test-results", "playwright-report"],

  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "paths": {
      "@/*": ["./src/*"]
    },

    "verbatimModuleSyntax": true
  }
}
