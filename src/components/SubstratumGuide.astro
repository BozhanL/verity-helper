---
import { getMessages, type Locale } from "../i18n/messages";
import ShapeIcon from "./ShapeIcon";

interface Props {
  locale: Locale;
  checklistUrl: string;
}
const { locale, checklistUrl } = Astro.props;
const messages = getMessages(locale);
const text = messages.substratumTool;
---

<div class="substratum-guide">
  <div class="substratum-intro">
    <ul class="substratum-facts" aria-label={text.flow}>
      <li>{text.cycles}</li>
      <li>{text.conductors}</li>
      <li>{text.stacks}</li>
    </ul>
    <a class="button button--primary" href={checklistUrl}>
      {messages.substratumChecklist} <span aria-hidden="true">→</span>
    </a>
  </div>
  <p class="helper-note">{text.start}</p>
  <ol class="substratum-flow" aria-label={text.flow}>
    {text.steps.map((step, index) => (
      <li class="panel">
        <span class="panel-number" aria-hidden="true">
          {index + 1}
        </span>
        <h2>{step.title}</h2>
        <p>{step.cue}</p>
      </li>
    ))}
  </ol>
  <section class="panel substratum-roles" aria-labelledby="roles-title">
    <h2 id="roles-title">{text.rolesTitle}</h2>
    <div class="substratum-diagram" role="img" aria-label={text.pulseDiagram}>
      <div>
        <span class="substratum-plate">●</span>
        <strong>{text.sender}</strong>
      </div>
      <span class="substratum-wire" aria-hidden="true">
        ⇄
      </span>
      <div>
        <span class="substratum-plate">
          <ShapeIcon shape="pyramid" />
        </span>
        <strong>{text.closer}</strong>
      </div>
      <span class="substratum-center">{text.center}</span>
    </div>
    <div class="substratum-role-grid">
      {text.roles.map((role) => (
        <div>
          <h3>{role.title}</h3>
          <p>{role.detail}</p>
        </div>
      ))}
    </div>
  </section>
  <p class="substratum-safety">
    <ShapeIcon shape="triangle" />
    <span>{text.safety}</span>
  </p>
  <details class="panel substratum-details">
    <summary>{text.mechanicsTitle}</summary>
    {text.steps.map((step) => (
      <div>
        <h3>{step.title}</h3>
        <p>{step.detail}</p>
      </div>
    ))}
  </details>
  <details class="panel substratum-details">
    <summary>{text.recoveryTitle}</summary>
    <ul>
      {text.recovery.map((tip) => (
        <li>{tip}</li>
      ))}
    </ul>
  </details>
  <details class="panel substratum-details">
    <summary>{text.optionalTitle}</summary>
    <h3>{text.scenic}</h3>
    <p>{text.scenicDetail}</p>
    <h3>{text.touch}</h3>
    <p>{text.touchDetail}</p>
    <p class="helper-note">{text.optionalNote}</p>
  </details>
  <details class="panel substratum-details">
    <summary>{text.sources}</summary>
    <p class="helper-note">{text.sourceNote}</p>
    <ul class="reference-links">
      <li>
        <a href="https://www.shacknews.com/article/140025/salvations-edge-raid-guide-destiny-2">
          {text.walkthrough}
        </a>
      </li>
      <li>
        <a href="https://professionalism.gg/raid-guides/salvations-edge">
          {text.plateGuide}
        </a>
      </li>
      <li>
        <a href="https://www.destinypedia.com/Salvation%27s_Edge#Substratum">
          {text.rulesGuide}
        </a>
      </li>
      <li>
        <a href="https://kyberscorner.com/destiny2/raid-challenges/">
          {text.challengeGuide}
        </a>
      </li>
      <li>
        <a href="https://www.light.gg/db/legend/triumphs/2062070439/touch-and-go/">
          {text.triumphGuide}
        </a>
      </li>
    </ul>
  </details>
</div>
