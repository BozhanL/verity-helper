---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getMessages, type Locale, type Page } from "../i18n/messages";
import Layout from "../layouts/Layout.astro";
import { SHAPES } from "../lib/verity";
import { GoalBoard } from "./Board";
import Calculator from "./Calculator";
import Exercise from "./Exercise";
import SiteHeader from "./SiteHeader";
import SoloCalculator from "./SoloCalculator";

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const messages = getMessages(locale);
const content = {
  calculator: {
    title: messages.calculator,
    heading: messages.calculatorTitle,
    description: messages.calculatorDescription,
  },
  solo: {
    title: messages.solo,
    heading: messages.soloTitle,
    description: messages.soloDescription,
  },
  exercise: {
    title: messages.exercise,
    heading: messages.exerciseTitle,
    description: messages.exerciseDescription,
  },
}[page];
const path = page === "calculator" ? undefined : page;
const links = {
  calculator: getRelativeLocaleUrl(locale),
  solo: getRelativeLocaleUrl(locale, "solo"),
  exercise: getRelativeLocaleUrl(locale, "exercise"),
  en: getRelativeLocaleUrl("en", path),
  zh: getRelativeLocaleUrl("zh", path),
};
---

<Layout
  locale={locale}
  page={page}
  title={content.title}
  description={content.description}
>
  <SiteHeader locale={locale} page={page} links={links} client:load />
  <main id="main">
    <header class="hero">
      <p class="eyebrow">{messages.encounter}</p>
      <h1>{content.heading}</h1>
    </header>
    {page === "calculator" && <Calculator locale={locale} client:load />}
    {page === "solo" && <SoloCalculator locale={locale} client:load />}
    {page === "exercise" && <Exercise locale={locale} client:load />}
    {page === "calculator" && (
      <aside class="rule-note">
        <h2>{messages.rulesTitle}</h2>
        <GoalBoard inside={SHAPES} locale={locale} showPositions={false} />
      </aside>
    )}
  </main>
  <footer class="site-footer">
    <p>{messages.footer}</p>
    <nav class="reference-links" aria-label={messages.references}>
      <a href="https://yugnar.com/verityCalculator/">
        {messages.referenceCalculator}
      </a>
      <a href="https://static.19970301.xyz/the_final_shape/dist/index.html#/">
        {messages.referenceExercise}
      </a>
      <a href="https://github.com/BozhanL/verity-helper">
        {messages.repository}
      </a>
    </nav>
  </footer>
</Layout>
