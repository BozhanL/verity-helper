---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getMessages, type Locale, type Page } from "../i18n/messages";
import Layout from "../layouts/Layout.astro";
import { SHAPES } from "../lib/verity";
import { getEncounter, PAGE_PATHS } from "../lib/navigation";
import { GoalBoard } from "./Board";
import Calculator from "./Calculator";
import Exercise from "./Exercise";
import SiteHeader from "./SiteHeader";
import SoloCalculator from "./SoloCalculator";
import RepositoryHelper from "./RepositoryHelper";
import ShapeIcon from "./ShapeIcon";

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const messages = getMessages(locale);
const content = {
  home: {
    title: messages.homeTitle,
    heading: messages.homeTitle,
    description: messages.homeDescription,
  },
  repository: {
    title: messages.repositoryTool.title,
    heading: messages.repositoryTool.title,
    description: messages.repositoryTool.description,
  },
  calculator: {
    title: messages.calculator,
    heading: messages.calculatorTitle,
    description: messages.calculatorDescription,
  },
  solo: {
    title: messages.solo,
    heading: messages.soloTitle,
    description: messages.soloDescription,
  },
  exercise: {
    title: messages.exercise,
    heading: messages.exerciseTitle,
    description: messages.exerciseDescription,
  },
}[page];
const path = PAGE_PATHS[page];
const encounter = getEncounter(page);
const encounterEyebrows = {
  repository: messages.repositoryTool.encounter,
  verity: messages.encounter,
};
const eyebrow =
  encounter === null ? messages.siteEyebrow : encounterEyebrows[encounter];
const links = {
  home: getRelativeLocaleUrl(locale, PAGE_PATHS.home),
  repository: getRelativeLocaleUrl(locale, PAGE_PATHS.repository),
  calculator: getRelativeLocaleUrl(locale, PAGE_PATHS.calculator),
  solo: getRelativeLocaleUrl(locale, PAGE_PATHS.solo),
  exercise: getRelativeLocaleUrl(locale, PAGE_PATHS.exercise),
  en: getRelativeLocaleUrl("en", path),
  zh: getRelativeLocaleUrl("zh", path),
};
---

<Layout
  locale={locale}
  page={page}
  title={content.title}
  description={content.description}
>
  <SiteHeader locale={locale} page={page} links={links} client:load />
  <main id="main">
    <header class="hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{content.heading}</h1>
    </header>
    {page === "home" && (
      <div class="encounter-grid">
        <a class="panel encounter-card" href={links.repository}>
          <span class="encounter-icon">
            <ShapeIcon shape="square" />
          </span>
          <h2>{messages.repositoryEncounter}</h2>
          <p>{messages.repositoryTool.description}</p>
        </a>
        <a class="panel encounter-card" href={links.calculator}>
          <span class="encounter-icon">
            <ShapeIcon shape="prism" />
          </span>
          <h2>{messages.verityEncounter}</h2>
          <p>{messages.verityDescription}</p>
          <span class="encounter-tools">
            {messages.calculator} · {messages.solo} · {messages.exercise}
          </span>
        </a>
      </div>
    )}
    {page === "repository" && <RepositoryHelper locale={locale} client:load />}
    {page === "calculator" && <Calculator locale={locale} client:load />}
    {page === "solo" && <SoloCalculator locale={locale} client:load />}
    {page === "exercise" && <Exercise locale={locale} client:load />}
    {page === "calculator" && (
      <aside class="rule-note">
        <h2>{messages.rulesTitle}</h2>
        <GoalBoard inside={SHAPES} locale={locale} showPositions={false} />
      </aside>
    )}
  </main>
  <footer class="site-footer">
    <p>{messages.footer}</p>
    <nav class="reference-links" aria-label={messages.references}>
      {page === "repository" && (
        <a href="https://www.destructoid.com/destiny-2-salvations-edge-third-encounter-raid-guide-repository/">
          {messages.repositoryTool.reference}
        </a>
      )}
      <a href="https://yugnar.com/verityCalculator/">
        {messages.referenceCalculator}
      </a>
      <a href="https://static.19970301.xyz/the_final_shape/dist/index.html#/">
        {messages.referenceExercise}
      </a>
      <a href="https://github.com/BozhanL/verity-helper">
        {messages.repository}
      </a>
    </nav>
  </footer>
</Layout>
