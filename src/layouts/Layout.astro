---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getMessages, type Locale, type Page } from "../i18n/messages";
import "../styles/global.css";

interface Props {
  locale: Locale;
  page: Page;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const messages = getMessages(locale);
const path = page === "exercise" ? "exercise" : undefined;
const canonical = Astro.site
  ? new URL(getRelativeLocaleUrl(locale, path), Astro.site)
  : undefined;
const english = getRelativeLocaleUrl("en", path);
const chinese = getRelativeLocaleUrl("zh", path);
const favicon = import.meta.env.BASE_URL + "favicon.svg";
---

<!doctype html>
<html lang={locale === "zh" ? "zh-Hans" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7fb" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      hreflang="en"
      href={Astro.site ? new URL(english, Astro.site) : english}
    />
    <link
      rel="alternate"
      hreflang="zh-Hans"
      href={Astro.site ? new URL(chinese, Astro.site) : chinese}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {messages.brand}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {messages.skip}
    </a>
    <slot />
    <noscript class="noscript-message">{messages.noScript}</noscript>
  </body>
</html>
